    "test": "vitest run",
    "extract-mockups": "tsx scripts/extract-mockups.ts",
    "smoke": "node scripts/smoke-check.mjs"
  },
  "devDependencies": { "tsx": "^4.23.15", "vitest": "^5.0.3" }
}
