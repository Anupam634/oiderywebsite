{
  "name": "@store/stitch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser stitch engine: turns a logo, motif or name into thread colours and renders it embroidered onto real garment photos",
  "exports": { ".": "./src/index.ts" },
