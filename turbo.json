{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "generate": { "cache": false },
    "build": { "dependsOn": ["^build", "generate"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "dev": { "cache": false, "persistent": true },
    "test": { "dependsOn": ["^build", "generate"], "outputs": [] },
    "typecheck": { "dependsOn": ["^build", "generate"], "outputs": [] },
    "lint": { "outputs": [] }
  }
}
