# The store API: the server renders pages from it, and the browser reaches it through this site's /api proxy
API_URL=http://localhost:4000
# same value as the API's PROXY_KEY (lets the API trust the shopper address the proxy passes on)
PROXY_KEY=change-me-to-a-long-random-string
# set to 1 on the real launch so search engines may index the site
NEXT_PUBLIC_INDEXABLE=0
# product photos on a public bucket or CDN (the API's S3_PUBLIC_URL host, e.g. media.example.com): lets the
# storefront resize them; comma-separated, read at build time. Leave empty while photos come through the API.
NEXT_PUBLIC_IMAGE_HOSTS=
# analytics (read at build time; leave empty to switch off). Meta Pixel ID from Events Manager (Instagram and
# Facebook ads), Google Analytics 4 measurement ID (G-XXXXXXX). The privacy policy mentions whichever is on.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
