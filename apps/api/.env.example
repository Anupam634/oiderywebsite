# ---------------------------------------------------------------------------------------------
# Store API settings. Copy to .env for local development. Values here are safe local defaults:
# no real SMS, payments, emails or WhatsApp messages are sent until you switch the providers.
# ---------------------------------------------------------------------------------------------

# Database (local: start it with `pnpm db:start`)
DATABASE_URL=postgresql://store:store@localhost:54329/store
SHADOW_DATABASE_URL=postgresql://store:store@localhost:54329/store_shadow

PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# the storefront's public address (links in emails, WhatsApp messages and invoices)
APP_URL=http://localhost:3000
# origins allowed to call the API directly (the storefront normally goes through its /api proxy)
WEB_ORIGIN=http://localhost:3000
# same long random string in the web app's PROXY_KEY: lets the API trust the shopper address the proxy passes on
PROXY_KEY=local-dev-proxy-key
# how many load balancers sit in front of the API (0 locally; usually 1 on Railway/Render/Fly)
TRUST_PROXY=0
# the storefront refreshes its catalogue cache when the admin edits products
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
# long random string; signs private file links (logos, proofs, invoices)
FILE_SIGNING_SECRET=dev-only-file-signing-secret

# Login codes: dev (code shown on screen) | twilio (Twilio Verify) | msg91 (needs a DLT-approved template)
OTP_PROVIDER=dev
# OTP_DEV_CODE=123456
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Payments: fake (test sheet) | razorpay (test or live keys from the Razorpay dashboard)
PAYMENTS_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard → Webhooks → https://api.your-domain/v1/webhooks/razorpay
# events: payment.authorized, payment.captured, payment.failed, order.paid, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=
# unpaid online orders are cancelled (and stock released) after this many minutes
PENDING_ORDER_MINUTES=30

# Email: outbox (written to .data/outbox) | resend
EMAIL_PROVIDER=outbox
RESEND_API_KEY=
EMAIL_FROM=Taanka <orders@example.com>
# new-order and proof alerts for the studio
OWNER_EMAIL=owner@example.com

# WhatsApp: outbox | meta (WhatsApp Cloud API; templates listed in src/modules/notify/messages.ts)
WHATSAPP_PROVIDER=outbox
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_TEMPLATE_LANG=en
OWNER_WHATSAPP=

# Files: local (.data/uploads) | s3 (Cloudflare R2, AWS S3, Backblaze B2…)
STORAGE=local
UPLOAD_DIR=.data/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# optional: a separate PUBLIC bucket for product photos and its address (e.g. https://media.your-domain).
# Never make S3_BUCKET itself public: it holds customer logos, photos and invoices.
S3_PUBLIC_BUCKET=
S3_PUBLIC_URL=

# First start on a new server: creates the owner login when there is none (remove the password afterwards)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Stitch-file tools (PES/DST conversion and previews)
PYTHON_BIN=python3

# A demo/staging server may run on test switches; a real shop never should
ALLOW_FAKE_PAYMENTS=0
ALLOW_DEV_OTP=0
