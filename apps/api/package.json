{
  "name": "@store/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Store API: Fastify + Prisma (PostgreSQL)",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "tsx scripts/dev-db.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts",
    "start:local": "node --env-file=.env dist/server.js",
    "generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@store/shared": "workspace:*",
    "aws4fetch": "^1.0.20",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "prisma": "7.10.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "openapi-types": "^12.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts",
    "assets",
    "tools"
  ]
}
