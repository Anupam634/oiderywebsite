# Server settings for deploy/docker-compose.yml. Everything the API reads is listed in apps/api/.env.example.
DOMAIN=your-shop.in
DB_PASSWORD=change-me-long-random
# same value is given to the web container; generate with: openssl rand -hex 32
PROXY_KEY=change-me-long-random
FILE_SIGNING_SECRET=change-me-long-random
INDEXABLE=0

# go-live switches (see DEPLOY.md)
OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
PAYMENTS_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Your Shop <orders@your-shop.in>
OWNER_EMAIL=
WHATSAPP_PROVIDER=meta
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
OWNER_WHATSAPP=
STORAGE=local
