{
  "name": "embroidery-store-platform",
  "private": true,
  "description": "Embroidery store: Next.js storefront, Fastify API, shared packages",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "db:start": "pnpm --filter @store/api db:start",
    "db:migrate": "pnpm --filter @store/api db:migrate",
    "db:seed": "pnpm --filter @store/api db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.6",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@10.34.6"
}
